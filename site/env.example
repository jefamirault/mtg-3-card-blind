# Copy to site/.env and fill in. .env is git-ignored; this template is committed.

# Deploy target for site/deploy.sh (rsync over SSH).
DEPLOY_USER=deploy
DEPLOY_HOST=143.244.201.147
DEPLOY_PATH=/var/www/3cb
# Where the site is served (nginx-mtg-3cb.conf maps it to DEPLOY_PATH). No trailing slash.
SITE_URL=https://mtg.jefamirault.com/3cb

# The request service (site/requests/server.js) on the same server.
# REQUESTS_DIR holds server.js, its env file and its data (requests.json).
REQUESTS_DIR=/home/deploy/3cb-requests
REQUESTS_PORT=4581
# The key that collects requests and marks them done. Make one with: openssl rand -hex 24
REQUESTS_TOKEN=
