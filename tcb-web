#!/usr/bin/env bash
# 3 Card Blind web UI. Build first with ./build.sh. Options: --port 8080 --entries entries --threads N
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
jar="$root/web/target/tcb-web-0.1.0-SNAPSHOT.jar"
if [[ ! -f "$jar" ]]; then
    echo "tcb-web: $jar not found; run ./build.sh first" >&2
    exit 1
fi
exec java ${TCB_JAVA_OPTS:-} -Xss512m -Xmx${TCB_HEAP:-8g} \
    -Dtcb.forgeGuiDir="$root/forge/forge-gui" \
    -cp "$jar:$root/web/target/lib/*" tcb.web.WebServer "$@"
